{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Skill Orchestrator registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skills"],
  "properties": {
    "schema_version": { "const": 1 },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "version", "source", "license", "provenance", "files"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "path", "repository", "revision"],
            "properties": {
              "type": { "enum": ["bundled", "git"] },
              "path": { "type": "string", "minLength": 1 },
              "repository": { "type": ["string", "null"] },
              "revision": { "type": ["string", "null"] }
            }
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": ["spdx", "license_file", "source_url", "redistribution"],
            "properties": {
              "spdx": { "type": "string", "minLength": 1 },
              "license_file": { "type": "string", "minLength": 1 },
              "source_url": { "type": ["string", "null"] },
              "redistribution": { "type": "boolean" }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["publisher", "maintainer", "third_party"],
            "properties": {
              "publisher": { "type": "string", "minLength": 1 },
              "maintainer": { "type": "string", "minLength": 1 },
              "third_party": { "type": "boolean" }
            }
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema_version", "filesystem", "network", "process"],
            "properties": {
              "schema_version": { "const": 1 },
              "filesystem": {
                "type": "object",
                "additionalProperties": false,
                "required": ["read", "write"],
                "properties": {
                  "read": {
                    "type": "array",
                    "maxItems": 64,
                    "uniqueItems": true,
                    "items": { "enum": ["project", "workspace", "unrestricted"] }
                  },
                  "write": {
                    "type": "array",
                    "maxItems": 64,
                    "uniqueItems": true,
                    "items": { "enum": ["project", "workspace", "unrestricted"] }
                  }
                }
              },
              "network": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode"],
                "properties": {
                  "mode": { "enum": ["none", "localhost", "restricted", "unrestricted", "unknown"] }
                }
              },
              "process": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "commands"],
                "properties": {
                  "mode": { "enum": ["none", "commands", "arbitrary", "unknown"] },
                  "commands": {
                    "type": "array",
                    "maxItems": 64,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
                    }
                  }
                },
                "allOf": [
                  {
                    "if": { "properties": { "mode": { "const": "commands" } } },
                    "then": { "properties": { "commands": { "minItems": 1 } } },
                    "else": { "properties": { "commands": { "maxItems": 0 } } }
                  }
                ]
              }
            }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}
