{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Skill Orchestrator project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profile", "skills", "analysis"],
  "properties": {
    "version": { "const": 1 },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "skills": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detected"],
      "properties": {
        "detected": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    }
  }
}
