{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Skill Orchestrator profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "aliases",
    "description",
    "extends",
    "policy",
    "routes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "description": { "type": "string", "minLength": 1 },
    "extends": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "reasoning_hint", "max_active_routes", "prefer_explicit_invocation"],
      "properties": {
        "mode": { "enum": ["balanced", "economy", "deep", "focused", "scaled", "research", "security", "custom"] },
        "reasoning_hint": { "enum": ["low", "medium", "high"] },
        "max_active_routes": { "type": "integer", "minimum": 1, "maximum": 8 },
        "prefer_explicit_invocation": { "type": "boolean" }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intent", "keywords", "capability_hints", "guidance", "priority"],
        "properties": {
          "intent": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "keywords": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "capability_hints": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
          "guidance": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    }
  }
}
